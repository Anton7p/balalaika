# Скопируйте в ".env" и заполните значения.
# cp .env.example .env

# -----------------------------------------------------------------------------
# Приложение
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Telegram (@BotFather)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# Исходящие запросы к api.telegram.org через прокси (если без VPN таймаут). Пример: SOCKS5 на 10808:
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
# Или HTTP-прокси: TELEGRAM_PROXY_URL=http://127.0.0.1:10808

# Сессии Telegraf (Redis) и rate limiting
TELEGRAM_SESSION_TTL_SECONDS=86400
TELEGRAM_SESSION_KEY_PREFIX=tg:sess:
TELEGRAM_RL_WINDOW_SECONDS=60
TELEGRAM_RL_MAX=40
TELEGRAM_RL_KEY_PREFIX=tg:rl:

# -----------------------------------------------------------------------------
# PostgreSQL (Prisma и др.) — одна строка подключения
# Локально Nest на хосте + Docker: проброс портов см. docker-compose.local.yml
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d postgres redis
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://balalaika:balalaika@localhost:5435/balalaika?schema=public

# Переменные для docker-compose (сервис postgres) — логин/пароль/БД должны совпадать с DATABASE_URL
POSTGRES_USER=balalaika
POSTGRES_PASSWORD=balalaika
POSTGRES_DB=balalaika
# Если на ПК уже есть Postgres на 5432, поднимайте Docker Postgres на другом порту и поправьте DATABASE_URL.
POSTGRES_PORT=5435

# -----------------------------------------------------------------------------
# Redis (сессии Telegraf, rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Альтернатива: REDIS_URL=redis://:password@localhost:6379 (если решите читать URL в коде)

# -----------------------------------------------------------------------------
# White-label: юридические ссылки и гайды по платформам (необязательно; иначе example.com)
# -----------------------------------------------------------------------------
LEGAL_FAQ_URL=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
PLATFORM_GUIDE_IOS_URL=
PLATFORM_GUIDE_ANDROID_URL=
PLATFORM_GUIDE_WINDOWS_URL=
PLATFORM_GUIDE_MACOS_URL=

# -----------------------------------------------------------------------------
# VPN stub / интеграция (демо URI и опциональный HEAD healthcheck)
# -----------------------------------------------------------------------------
WHITE_LABEL_VPN_HOST=vpn.example.local
WHITE_LABEL_KEY_PROFILE_SLUG=access
VPN_HEALTHCHECK_URL=

# -----------------------------------------------------------------------------
# GitHub Container Registry (docker login ghcr.io, CI pull/push образов)
# Classic PAT: read:packages, write:packages (при push); для приватных образов часто нужен repo
# -----------------------------------------------------------------------------
GHCR_USERNAME=
GHCR_TOKEN=
