services:
  marzban-node:
    image: {{ marzban_node_image }}
    container_name: marzban-node
    restart: always
    network_mode: host
    environment:
      - SSL_CLIENT_CERT_FILE=/var/lib/marzban-node/ssl_client_cert.pem
      - SERVICE_PROTOCOL=rest
    volumes:
      - {{ node_var_dir }}:/var/lib/marzban-node:rw
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
