# Telegram daily backups (cron on master). Не коммитить с сервера.
{% set admin_bot = telegram_bot_admin | default('', true) | trim %}
{% set app_bot = telegram_bot_token | trim %}
{% set backup_bot = admin_bot if admin_bot | length > 0 else app_bot %}
{% set admin_chat = telegram_admin_id | default('', true) | trim %}
{% if admin_chat | length == 0 %}
# TELEGRAM_CHAT_ID required — задайте TELEGRAM_ADMIN_ID при деплое
{% endif %}
TELEGRAM_BOT_TOKEN={{ backup_bot }}
TELEGRAM_CHAT_ID={{ admin_chat }}

APP_DIR={{ app_dir }}
PANEL_DIR={{ deploy_root }}/panel
DOMAIN_NAME={{ domain_name }}

# true — копировать x-ui.db в этом скрипте; false — панель шлёт 3x-ui (tgBotBackup + TELEGRAM_BOT_ADMIN)
{% if admin_bot | length > 0 %}
BACKUP_INCLUDE_PANEL={{ backup_include_panel | default('false', true) }}
{% else %}
BACKUP_INCLUDE_PANEL={{ backup_include_panel | default('true', true) }}
{% endif %}

BACKUP_WORK_DIR={{ deploy_root }}/backup/work
TELEGRAM_MAX_BYTES=47185920
