NODE_ENV=production
PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD={{ app_db_password }}
POSTGRES_DB=app
DATABASE_URL=postgresql://postgres:{{ app_db_password }}@postgres:5432/app?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ vpn_admin_password }}

TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
ENCRYPTION_KEY={{ encryption_key }}

{# Один Telegram User ID админа бота. См. BOTFATHER_SETUP.md #}
{% set admin_id = telegram_admin_id | default('', true) | trim %}
{% if admin_id | length > 0 %}
TELEGRAM_ADMIN_ID={{ admin_id }}
{% endif %}

{% set support_url = telegram_support_url | default('', true) | trim %}
{% if support_url | length > 0 %}
TELEGRAM_SUPPORT_URL={{ support_url }}
{% endif %}

VPN_PANEL_URL=https://{{ domain_name }}
VPN_ADMIN_USERNAME={{ vpn_admin_username }}
VPN_ADMIN_PASSWORD={{ vpn_admin_password }}
DOMAIN_NAME={{ domain_name }}

NODE_IPS={{ node_ips }}
VPN_INBOUND_CLIENT_LIMIT={{ vpn_inbound_client_limit }}

VPN_WATCHDOG_ENABLED={{ vpn_watchdog_enabled }}
VPN_WATCHDOG_INTERVAL_SEC={{ vpn_watchdog_interval_sec }}
VPN_WATCHDOG_FAIL_THRESHOLD={{ vpn_watchdog_fail_threshold }}
VPN_WATCHDOG_HOOK_SECRET={{ vpn_watchdog_hook_secret }}
VPN_WATCHDOG_MONITOR_CARRYING_NODES={{ vpn_watchdog_monitor_carrying_nodes }}
