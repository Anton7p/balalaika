[master]
master_host ansible_host={{ ci_master_host }} ansible_user=root ansible_password='{{ ci_master_password }}'

[master:vars]
ansible_connection=ssh
ansible_become=true

[nodes]
{% for n in ci_inventory_nodes | default([]) %}
node{{ loop.index }} ansible_host={{ n.host }} ansible_user=root ansible_password='{{ n.password }}'
{% endfor %}

[nodes:vars]
ansible_connection=ssh
ansible_become=true
