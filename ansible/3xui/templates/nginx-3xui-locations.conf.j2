# Managed by Ansible (3x-ui): reverse proxy to local panel (Docker publish).
      location ^~ /panel/ws {
          proxy_pass http://127.0.0.1:{{ xui_panel_http_port }}/panel/panel/ws;
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection "upgrade";
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-Host $host;
          proxy_read_timeout 86400;
      }
      location ^~ /panel/panel/ws {
          proxy_pass http://127.0.0.1:{{ xui_panel_http_port }};
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection "upgrade";
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-Host $host;
          proxy_read_timeout 86400;
      }
      location ^~ /panel/ {
          proxy_pass http://127.0.0.1:{{ xui_panel_http_port }};
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-Host $host;
          proxy_set_header Accept-Language "{{ xui_panel_accept_language | default('ru-RU') }}";
          proxy_buffering off;
      }
      location ^~ /sub/ {
          proxy_pass http://127.0.0.1:{{ xui_panel_http_port }};
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-Host $host;
      }
